###############################################################################
#
# Include file for Kairos CPU
#
###############################################################################
#
# CHAN  : communication technique used in OASIS3 (MPI1/MPI2/NONE)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          = path_to_models_directory/libraries/oasis3-mct_$(version_oasis)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         = $(COUPLE)/build_oa3-mct
#
# MPI library
MPIDIR           = $(I_MPI_ROOT)
MPIBIN           = $(MPIDIR)/bin
MPI_INCLUDE      = $(MPIDIR)/include
MPILIB           = -L$(MPIDIR)/lib -lmpi
#
# NETCDF library
NETCDF_INCLUDE  = `${NETCDF_CONFIG} --includedir`
NETCDF_LIBRARY  = `${NETCDF_CONFIG} --flibs`
#
# Compiling and other commands
# You may have to load the corresponding intel module to compile
MAKE        = make
F90         = $(MPIBIN)/mpiifx -I$(MPI_INCLUDE)
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpiicx -I$(MPI_INCLUDE)
LD          = $(MPIBIN)/mpiifx $(MPILIB)
# Static libraries compilation options
STATOPT     =
# Shared libraries options
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lmpi_mpifh -lgfortran -lm
#
# CPP keys and compiler options
# 
CPPDEF       = -Duse_comm_$(CHAN) -D__VERBOSE -DTREAT_OVERLAY
FCBASEFLAGS  = -O2 -C -g -lpthread
CCBASEFLAGS  = -O2
#
#############################################################################
#
# Additional definitions that should not be changed
#
FLIBS           = $(NETCDF_LIBRARY)
# BINDIR        : directory for executables
BINDIR          = $(ARCHDIR)/bin
# LIBBUILD      : contains a directory for each library
LIBBUILD        = $(ARCHDIR)/build/lib
# INCPSMILE     : includes all *o and *mod for each library
INCPSMILE       = -I$(LIBBUILD)/psmile.$(CHAN) -I$(LIBBUILD)/scrip  -I$(LIBBUILD)/mct

F90FLAGS    = $(FCBASEFLAGS) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
f90FLAGS    = $(FCBASEFLAGS) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
FFLAGS      = $(FCBASEFLAGS) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
fFLAGS      = $(FCBASEFLAGS) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
CCFLAGS     = $(CCBASEFLAGS) $(INCPSMILE) $(CPPDEF) -I$(NETCDF_INCLUDE)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
